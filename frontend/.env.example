# Deployed DeadlineProof contract address on BOT Chain Testnet (Chain ID 968)
# Note: `npm run deploy:testnet` also automatically updates src/config/deployment.json
VITE_CONTRACT_ADDRESS=

# Reown (WalletConnect) Project ID — get a free ID at https://dashboard.reown.com
