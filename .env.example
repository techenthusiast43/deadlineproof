# Dedicated deployer private key for Hardhat deployment (with or without 0x prefix).
# Make sure this account holds test BOT (tBOT) from https://faucet.botchain.ai/basic
# NEVER commit your real .env file.
DEPLOYER_PRIVATE_KEY=

# Optional RPC overrides (defaults match official BOT Chain docs)
BOT_TESTNET_RPC_URL=https://rpc.bohr.life
BOT_MAINNET_RPC_URL=https://rpc.botchain.ai

